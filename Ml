
# 1. Import libraries
import matplotlib.pyplot as plt
from sklearn.datasets import make_classification
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score

# 2. Create synthetic dataset
X, y = make_classification(
    n_samples=500,
    n_features=10,
    random_state=42
)

# 3. Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

# 4. Test different tree depths
depths = [1, 3, 5, None]

for d in depths:

    model = DecisionTreeClassifier(
        max_depth=d, random_state=42
    )

    model.fit(X_train, y_train)

    train_acc = accuracy_score(y_train, model.predict(X_train))
    test_acc = accuracy_score(y_test, model.predict(X_test))

    print("Depth:", d)
    print("Training Accuracy:", train_acc)
    print("Testing Accuracy:", test_acc)
    print("-------------------")

# 5. Apply pruning
pruned_model = DecisionTreeClassifier(
    max_depth=5,
    ccp_alpha=0.01,
    random_state=42
)

pruned_model.fit(X_train, y_train)

print("Pruned Model Accuracy:",
      accuracy_score(y_test, pruned_model.predict(X_test)))

# 6. Plot graph
plt.plot(depths[:-1] + [10], [
    accuracy_score(y_test, DecisionTreeClassifier(
        max_depth=d, random_state=42
    ).fit(X_train, y_train).predict(X_test))
    for d in depths
], marker='o')

plt.xlabel("Tree Depth")
plt.ylabel("Testing Accuracy")
plt.title("Decision Tree Overfitting")
plt.grid()
plt.show()
